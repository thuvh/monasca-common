      "writtenOn": "2016-01-08T02:02:49Z",
      "side": 1,
      "message": "With most of these common methods, it might be better to create and return exceptions, similar to the UnsupportedContentType exception rather than just logging and then throwing whatever exception was thrown.\n\nIn this case there is no content in the message request body. Is that really an exception that should be propogated up, or something that should just result in a no-op.",
      "range": {
        "startLine": 70,
        "startChar": 8,
        "endLine": 70,
        "endChar": 11
      },
      "revId": "4d4bdeef4c54fabefd6180e7d60a2fa9688236d2",
