        "id": 2419
      },
      "writtenOn": "2016-01-08T02:02:49Z",
      "side": 1,
      "message": "It is not possible to translate the request body to json.  Ultimately, you wold like to return a Bad Request or Unprocessable Entity to the user. Would it be better to just throw that type of exception here, rather than re-throwing the exception, and requiring the client to catch and process further.",
      "range": {
        "startLine": 78,
        "startChar": 8,
        "endLine": 78,
        "endChar": 13
      },
      "revId": "4d4bdeef4c54fabefd6180e7d60a2fa9688236d2",
